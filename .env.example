# Anthropic / Claude
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=1024

# App metadata
APP_NAME=datum-skill-brain
APP_VERSION=0.1.0
ENVIRONMENT=development

# CORS (comma-separated origins, or * for all)
CORS_ALLOW_ORIGINS=*

# --- Database ---
# Three separate URLs, three separate Postgres roles, on purpose — see
# DATUM_AI_BOOKKEEPING_TEAM_PLAN.md Section 10. admin is the schema owner
# used only by Alembic/scripts/seed_dev.py, never by request-handling code.
ADMIN_DATABASE_URL=postgresql+psycopg2://datumai_admin:datumai_admin_dev_pw@localhost:5432/datumai_dev
AI_SERVICE_DATABASE_URL=postgresql+psycopg2://datumai_ai_service:datumai_ai_service_dev_pw@localhost:5432/datumai_dev
CPA_SERVICE_DATABASE_URL=postgresql+psycopg2://datumai_cpa_service:datumai_cpa_service_dev_pw@localhost:5432/datumai_dev

# --- Auth ---
JWT_SECRET_KEY=change-me-in-every-environment
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
